# Mintry Fabric — Environment Variables
#
# DO NOT COMMIT THIS FILE TO VERSION CONTROL
# Duplicate this file as .env and fill in your values

# ── Control Plane (Supabase) ──────────────────────────────────────────────────
# Required for policy synchronization and telemetry uploads
MINTRY_CONTROL_PLANE_URL="https://your-project.supabase.co"
MINTRY_CONTROL_PLANE_KEY="your-anon-key"
MINTRY_SERVICE_ROLE_KEY="your-service-role-key"

# ── Policy Verification (ES256) ───────────────────────────────────────────────
# Generated by setup-supabase-integration.py
# Dashboard signs with PRIVATE; SDK verifies with PUBLIC (same keypair).
MINTRY_POLICY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
MINTRY_POLICY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Fail closed in production when private key missing (also implied by NODE_ENV=production)
# MINTRY_REQUIRE_POLICY_SIGNATURES=1
# Dev-only escape hatch (never in production):
# MINTRY_ALLOW_MOCK_SIGNATURES=1

# ── Dashboard auth ────────────────────────────────────────────────────────────
# When set, mutating Next routes require login cookie or Authorization: Bearer
MINTRY_DASHBOARD_ADMIN_TOKEN="change-me"
# Forwarded by Next BFF to the Python dashboard API
MINTRY_DASHBOARD_API_TOKEN="change-me-python"
# MINTRY_REQUIRE_AUTH=1
#
# Local SQLite upsert/revoke:
# - No control plane URL → allowed (air-gapped agent)
# - Control plane configured → DENIED unless you opt in:
# MINTRY_LOCAL_GOVERNANCE=1
# Prefer Sign & Push / Fleet / Org compile for production caps.

# ── Local Development ─────────────────────────────────────────────────────────
MINTRY_API_KEY="mk_dev_example"
MINTRY_DEMO_MODE=1
MINTRY_AGENT_ID="default_agent"
MINTRY_DASHBOARD_API_ORIGIN="http://127.0.0.1:8000"
MINTRY_DASHBOARD_UI_ORIGIN="http://localhost:3000"
# MINTRY_TELEMETRY_DISABLED=1
