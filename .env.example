# Mintry Fabric — Environment Variables

# ── Control Plane (Supabase) ──────────────────────────────────────────────────
MINTRY_CONTROL_PLANE_URL="https://your-project.supabase.co"
MINTRY_CONTROL_PLANE_KEY="your-anon-key"
MINTRY_SERVICE_ROLE_KEY="your-service-role-key"

# ── Policy Verification (ES256) ───────────────────────────────────────────────
MINTRY_POLICY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
MINTRY_POLICY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MINTRY_REQUIRE_POLICY_SIGNATURES=1
# MINTRY_ALLOW_MOCK_SIGNATURES=1  # dev only

# ── Agent identity & defaults ─────────────────────────────────────────────────
MINTRY_API_KEY="mk_dev_example"
MINTRY_AGENT_ID="default_agent"
MINTRY_DEFAULT_MANDATE=""           # optional override; defaults to MINTRY_AGENT_ID
MINTRY_DEFAULT_BUDGET_USD="50.0"    # seed budget for default_agent

# ── Notifications (async — off enforcement hot path) ──────────────────────────
MINTRY_WEBHOOK_URL=""               # generic JSON webhook for alerts/digests
MINTRY_SLACK_WEBHOOK_URL=""         # Slack incoming webhook
MINTRY_RESEND_API_KEY=""            # Resend API key for email alerts
MINTRY_ALERT_EMAIL_TO=""            # recipient for email alerts
MINTRY_ALERT_EMAIL_FROM="alerts@yourdomain.com"
# MINTRY_DIGEST_DISABLED=1
# MINTRY_DIGEST_INTERVAL_SEC=604800   # weekly digest (default 7 days)

# ── Stripe top-up (control plane / dashboard webhook) ───────────────────────
STRIPE_WEBHOOK_SECRET=""            # Stripe signing secret for /api/stripe/webhook

# ── Dashboard auth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# MINTRY_DASHBOARD_ALLOWED_EMAILS="you@company.com"
MINTRY_DASHBOARD_ADMIN_TOKEN="change-me"
MINTRY_DASHBOARD_API_TOKEN="change-me-python"
# MINTRY_REQUIRE_AUTH=1
# MINTRY_LOCAL_GOVERNANCE=1           # opt-in local ledger edits when CP configured

# ── Local development ───────────────────────────────────────────────────────
MINTRY_DEMO_MODE=1
MINTRY_DASHBOARD_API_ORIGIN="http://127.0.0.1:8000"
MINTRY_DASHBOARD_UI_ORIGIN="http://localhost:3000"
# MINTRY_TELEMETRY_DISABLED=1
